<?xml version="1.0" encoding="utf-8"?>
<!--
  scripted-counter: 点击 “+1” 按钮使数字 +1，点击 “重置” 归零；右侧开关切换是否在控制台输出每次点击。
  与同名 scripted-counter.js 配合使用 (由 Pixi2D.Host 自动加载)。
-->
<panel id="root" width="420" height="220" background-color="#202225">
    <fancy-text id="title" x="20" y="16" content="Scripted Counter" />
    <fancy-text id="lblCount" x="20" y="60" content="0" />

    <button id="btnInc"   x="20"  y="120" width="80" height="32" text="+1"     on-click="onInc" />
    <button id="btnReset" x="120" y="120" width="80" height="32" text="重置"   on-click="onReset" />

    <switch id="swLog" x="240" y="120" />
    <fancy-text id="lblLogHint" x="240" y="160" content="开关日志" />
</panel>
