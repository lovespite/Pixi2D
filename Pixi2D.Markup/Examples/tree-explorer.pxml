            <tree-node>
                <text content="Controls" />
                <tree-node><text content="Button.cs" /></tree-node>
                <tree-node><text content="Panel.cs" /></tree-node>
                <tree-node><text content="TextBox.cs" /></tree-node>
            </tree-node>
            <tree-node>
                <text content="Components" />
                <tree-node><text content="Modal.cs" /></tree-node>
                <tree-node><text content="FlowLayout.cs" /></tree-node>
            </tree-node>
        </tree-node>
        <tree-node>
            <text content="Pixi2D.Markup" />
            <tree-node><text content="ElementRegistry.cs" /></tree-node>
            <tree-node><text content="PxmlLoader.cs" /></tree-node>
        </tree-node>
