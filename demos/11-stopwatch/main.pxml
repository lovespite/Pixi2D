<?xml version="1.0" encoding="utf-8"?>
<panel id="root" width="420" height="240" background-color="#0b1220">
    <fancy-text x="24" y="16" content="秒表" />

    <fancy-text id="display" x="24" y="60" content="00:00.0" />

    <button id="btnStart" x="24"  y="140" width="90" height="36" text="开始" on-click="onStart" />
    <button id="btnStop"  x="130" y="140" width="90" height="36" text="暂停" on-click="onStop" />
    <button id="btnReset" x="236" y="140" width="90" height="36" text="重置" on-click="onReset" />
</panel>
