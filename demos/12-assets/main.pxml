<?xml version="1.0" encoding="utf-8"?>
<panel id="root" width="640" height="420" background-color="#0b1220">
    <fancy-text x="16" y="12" content="12 — assets demo (loadJson → table)" />
    <fancy-text id="status" x="16" y="36" content="loading sample.json ..." />

    <table id="grid" x="16" y="64" width="608" height="280" />

    <button id="btnReload" x="16"  y="360" width="120" height="36" text="Reload"     on-click="onReload" />
    <button id="btnRemote" x="148" y="360" width="160" height="36" text="Load Remote" on-click="onRemote" />
    <button id="btnClear"  x="320" y="360" width="120" height="36" text="Clear Cache" on-click="onClear" />
    <button id="btnStats"  x="452" y="360" width="120" height="36" text="Stats"       on-click="onStats" />
</panel>
