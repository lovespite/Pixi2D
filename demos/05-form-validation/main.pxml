<?xml version="1.0" encoding="utf-8"?>
<panel id="root" width="480" height="280" background-color="#0b1220">
    <fancy-text x="24" y="20" content="表单校验" />

    <fancy-text x="24" y="64"  content="姓名" />
    <text-box   id="txtName"  x="100" y="60"  width="350" height="28" placeholder-text="必填" />

    <fancy-text x="24" y="104" content="邮箱" />
    <text-box   id="txtEmail" x="100" y="100" width="350" height="28" placeholder-text="user@example.com" />

    <button     id="btnCheck" x="24" y="160" width="100" height="32" text="校验"   on-click="onCheck" />
    <button     id="btnReset" x="140" y="160" width="80" height="32" text="清空" on-click="onReset" />

    <fancy-text id="lblResult" x="24" y="220" content="点击校验按钮验证表单" />
</panel>
