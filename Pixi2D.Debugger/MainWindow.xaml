<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Pixi2D.Debugger.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:Pixi2D.Debugger.Models"
    Title="Pixi2D Debugger">

    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="0">
            <TextBlock Text="Host:" VerticalAlignment="Center" />
            <TextBox x:Name="HostBox" Text="127.0.0.1" Width="140" />
            <TextBlock Text="Port:" VerticalAlignment="Center" />
            <TextBox x:Name="PortBox" Text="9229" Width="80" />
            <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnectClick" />
            <Button x:Name="DisconnectBtn" Content="Disconnect" Click="OnDisconnectClick" IsEnabled="False" />
            <TextBlock x:Name="StatusText" Text="disconnected" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <Pivot Grid.Row="1" x:Name="MainPivot">

            <PivotItem Header="Tree">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Content="Refresh" Click="OnRefreshTreeClick" Grid.Row="0" />
                        <controls:TreeView x:Name="ElementTree"
                                           Grid.Row="1"
                                           SelectionMode="Single"
                                           ItemInvoked="OnTreeItemInvoked">
                            <controls:TreeView.ItemTemplate>
                                <DataTemplate x:DataType="models:TreeNodeVm">
                                    <controls:TreeViewItem ItemsSource="{x:Bind Children}" Content="{x:Bind Display, Mode=OneWay}" />
                                </DataTemplate>
                            </controls:TreeView.ItemTemplate>
                        </controls:TreeView>
                    </Grid>

                    <Grid Grid.Column="1" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SelectedPath" Grid.Row="0" Text="(no selection)" FontFamily="Consolas" TextWrapping="Wrap" />
                        <ListView x:Name="PropList" Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PropertyRow">
                                    <Grid ColumnSpacing="8" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                        <Grid Grid.Column="1">
                                            <TextBox Text="{x:Bind Value, Mode=TwoWay}"
                                                     Visibility="{x:Bind TextVisibility}"
                                                     LostFocus="OnPropTextLostFocus"
                                                     KeyDown="OnPropTextKeyDown"
                                                     Tag="{x:Bind Name}" />
                                            <CheckBox IsChecked="{x:Bind BoolValue, Mode=TwoWay}"
                                                      Visibility="{x:Bind BoolVisibility}"
                                                      Click="OnPropBoolClick"
                                                      Tag="{x:Bind Name}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <controls:InfoBar x:Name="PropInfo" Grid.Row="2" IsOpen="False" Severity="Error" />
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="Console">
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="Clear" Click="OnClearConsoleClick" Grid.Row="0" />
                    <ListView x:Name="ConsoleList" Grid.Row="1" FontFamily="Consolas">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Network">
                <ListView x:Name="NetList" FontFamily="Consolas">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Files">
                <ListView x:Name="FileList" FontFamily="Consolas">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Eval">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView x:Name="EvalList" Grid.Row="0" FontFamily="Consolas">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EvalInput" PlaceholderText="enter JS expression and press Enter" KeyDown="OnEvalKeyDown" />
                        <Button Content="Run" Click="OnEvalRunClick" Grid.Column="1" />
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>

        <TextBlock x:Name="HelloText" Grid.Row="2" Foreground="Gray" />
    </Grid>
</Window>
