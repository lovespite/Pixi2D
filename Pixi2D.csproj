<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 子项目 (类库 / 预览器) 不应被主项目编译 -->
    <Compile Remove="Pixi2D.Markup\**" />
    <Compile Remove="Pixi2D.Preview\**" />
    <EmbeddedResource Remove="Pixi2D.Markup\**" />
    <EmbeddedResource Remove="Pixi2D.Preview\**" />
    <None Remove="Pixi2D.Markup\**" />
    <None Remove="Pixi2D.Preview\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.XAudio2" Version="4.2.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
